      "\u001b[36mFile \u001b[39m\u001b[32m~\\AppData\\Local\\Programs\\Python\\Python314\\Lib\\site-packages\\torch\\autograd\\graph.py:1072\u001b[39m, in \u001b[36m_engine_run_backward\u001b[39m\u001b[34m(t_outputs, *args, **kwargs)\u001b[39m\n\u001b[32m   1069\u001b[39m torch._C._stash_obj_in_tls(\u001b[33m\"\u001b[39m\u001b[33mcontext\u001b[39m\u001b[33m\"\u001b[39m, contextvars.copy_context())\n\u001b[32m   1071\u001b[39m \u001b[38;5;28;01mtry\u001b[39;00m:\n\u001b[32m-> \u001b[39m\u001b[32m1072\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[30;43mVariable\u001b[39;49m\u001b[30;43m.\u001b[39;49m\u001b[30;43m_execution_engine\u001b[39;49m\u001b[30;43m.\u001b[39;49m\u001b[30;43mrun_backward\u001b[39;49m\u001b[30;43m(\u001b[39;49m\u001b[30;43m  \u001b[39;49m\u001b[30;43;03m# Calls into the C++ engine to run the backward pass\u001b[39;49;00m\n\u001b[32m   1073\u001b[39m \u001b[30;43m        \u001b[39;49m\u001b[30;43mt_outputs\u001b[39;49m\u001b[30;43m,\u001b[39;49m\u001b[30;43m \u001b[39;49m\u001b[30;43m*\u001b[39;49m\u001b[30;43margs\u001b[39;49m\u001b[30;43m,\u001b[39;49m\u001b[30;43m \u001b[39;49m\u001b[30;43m*\u001b[39;49m\u001b[30;43m*\u001b[39;49m\u001b[30;43mkwargs\u001b[39;49m\n\u001b[32m   1074\u001b[39m \u001b[30;43m    \u001b[39;49m\u001b[30;43m)\u001b[39;49m  \u001b[38;5;66;03m# Calls into the C++ engine to run the backward pass\u001b[39;00m\n\u001b[32m   1075\u001b[39m \u001b[38;5;28;01mfinally\u001b[39;00m:\n\u001b[32m   1076\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m attach_logging_hooks:\n",
      "\u001b[31mKeyboardInterrupt\u001b[39m: "
     ]
    }
   ],
   "source": [
    "# Final Training Hyperparameters\n",
    "EPOCHS = 25              # Full training epochs (increase to 50 for max convergence)\n",
    "BATCH_SIZE = 8           # Safe memory footprint for Intel Arc 2GB shared VRAM\n",
    "IMG_SIZE = 640           # Standard YOLO high-resolution input\n",
    "RUN_NAME = \"mhweed16_yolo11n_final\"\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(f\"Starting Final YOLO11n Training Run: {RUN_NAME}\")\n",
    "print(f\"- Dataset:    mhweed16.yaml (5,324 train images, 666 val images)\")\n",
    "print(f\"- Epochs:     {EPOCHS}\")\n",
    "print(f\"- Batch Size: {BATCH_SIZE}\")\n",
    "print(f\"- Image Size: {IMG_SIZE}\")\n",
    "print(f\"- Device:     {device}\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Instantiate fresh YOLO11n detector\n",
    "model = YOLO(\"yolo11n.pt\")\n",
    "\n",
    "# Load winning hyperparameters\n",
    "with open(best_hyp_file, 'r', encoding='utf-8') as f:\n",
    "    evolved_args = yaml.safe_load(f)\n",
    "\n",
    "# Execute Model Training\n",
    "train_results = model.train(\n",
    "    data=\"mhweed16.yaml\",\n",
    "    epochs=EPOCHS,\n",
    "    batch=BATCH_SIZE,\n",
    "    imgsz=IMG_SIZE,\n",
    "    device=device,\n",
    "    project=\"runs/detect\",\n",
    "    name=RUN_NAME,\n",
    "    exist_ok=True,\n",
    "    amp=True,\n",
    "    patience=10,\n",
    "    **evolved_args\n",
    ")\n",
    "\n",
    "print(\"\\nFinal Training Complete!\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2a7f7151",
   "metadata": {},
   "source": [
    "## 8. 🎯 Model Validation & Held-Out Test Set Evaluation\n",
    "We evaluate the final trained weights (`best.pt`) on the independent 10% test set (`test.txt`) to assess generalization and ensure the model has not overfitted.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a1b48d80",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Path to best model weights\n",
    "best_weights = pathlib.Path(f\"runs/detect/{RUN_NAME}/weights/best.pt\")\n",
    "\n",
    "if best_weights.exists():\n",
    "    eval_model = YOLO(str(best_weights))\n",
    "    print(f\"Loaded trained weights from: {best_weights}\")\n",
    "else:\n",
    "    print(f\"Best weights not found at {best_weights}, using active model for evaluation.\")\n",
    "    eval_model = model\n",
    "\n",
    "# Run evaluation on test split\n",
    "metrics = eval_model.val(data=\"mhweed16.yaml\", split=\"test\", imgsz=IMG_SIZE, batch=BATCH_SIZE)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"TEST SET EVALUATION SUMMARY:\")\n",
    "print(f\"mAP@0.50:       {metrics.box.map50:.4f}\")\n",
    "print(f\"mAP@0.50:0.95:  {metrics.box.map:.4f}\")\n",
    "print(f\"Mean Precision: {metrics.box.mp:.4f}\")\n",
    "print(f\"Mean Recall:    {metrics.box.mr:.4f}\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Display training loss and results curves if available\n",
    "results_img = pathlib.Path(f\"runs/detect/{RUN_NAME}/results.png\")\n",
    "if results_img.exists():\n",
    "    plt.figure(figsize=(14, 8))\n",
    "    img = Image.open(results_img)\n",
    "    plt.imshow(img)\n",
    "    plt.axis('off')\n",
    "    plt.title(\"YOLO11n Training & Validation Loss Curves\", fontsize=14, fontweight='bold')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5443fe1f",
   "metadata": {},
   "source": [
    "## 9. 🔍 Qualitative Visual Inference (Ground Truth vs. Predictions)\n",
    "We run inference on unseen images from the held-out test set and render side-by-side comparisons of the actual human annotations against the YOLO11 model predictions.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "82e6b471",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Select 3 random images from test.txt\n",
    "with open(\"test.txt\", 'r', encoding='utf-8') as f:\n",
    "    test_image_paths = [pathlib.Path(line.strip()) for line in f if line.strip()]\n",
    "\n",
    "random.seed(123)\n",
    "selected_test = random.sample(test_image_paths, min(3, len(test_image_paths)))\n",
    "\n",
    "for test_path in selected_test:\n",
    "    # 1. Ground truth image\n",
    "    ann_path = ANN_DIR / f\"{test_path.stem}.txt\"\n",
    "    img = cv2.imread(str(test_path))\n",
    "    gt_img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "    h_img, w_img, _ = gt_img.shape\n",
    "    \n",
    "    if ann_path.exists():\n",
    "        with open(ann_path, 'r', encoding='utf-8') as f:\n",
    "            for line in f:\n",
    "                parts = line.strip().split()\n",
    "                if parts:\n",
    "                    cls_id = int(parts[0])\n",
    "                    xc, yc, bw, bh = map(float, parts[1:5])\n",
    "                    x1 = int((xc - bw/2.0) * w_img)\n",
    "                    y1 = int((yc - bh/2.0) * h_img)\n",
    "                    x2 = int((xc + bw/2.0) * w_img)\n",
    "                    y2 = int((yc + bh/2.0) * h_img)\n",
    "                    cv2.rectangle(gt_img, (x1, y1), (x2, y2), (0, 255, 0), 3)\n",
    "                    cv2.putText(gt_img, f\"C{cls_id}\", (x1, max(y1-6, 20)),\n",
    "                                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)\n",
    "                                \n",
    "    # 2. Model prediction\n",
    "    pred_res = eval_model.predict(source=str(test_path), conf=0.25, imgsz=IMG_SIZE)[0]\n",
    "    pred_img = pred_res.plot() # Draws bounding boxes and labels\n",
    "    pred_img = cv2.cvtColor(pred_img, cv2.COLOR_BGR2RGB)\n",
    "    \n",
    "    # Plot side-by-side\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(15, 6))\n",
    "    axes[0].imshow(gt_img)\n",
    "    axes[0].set_title(f\"Ground Truth ({test_path.name})\", fontweight='bold', fontsize=12)\n",
    "    axes[0].axis('off')\n",
    "    \n",
    "    axes[1].imshow(pred_img)\n",
    "    axes[1].set_title(f\"YOLO11 Prediction (Conf >= 0.25)\", fontweight='bold', fontsize=12)\n",
    "    axes[1].axis('off')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7eca25f4",
   "metadata": {},
   "source": [
    "## 10. 📦 Model Export & Edge Deployment (Intel Arc / OpenVINO / ONNX)\n",
    "To deploy the trained YOLO11 weed detector to edge devices, agricultural robots, or drones, Ultralytics supports instant export to multiple optimized runtimes.\n",
    "- **OpenVINO**: Maximum inference acceleration on Intel Arc GPUs and Intel Core Ultra CPUs.\n",
    "- **ONNX**: Cross-platform format compatible with ONNX Runtime, TensorRT, and edge NPUs.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1f37a02a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Export model for production deployment\n",
    "print(\"Exporting trained model for hardware-accelerated deployment...\")\n",
    "\n",
    "# 1. Export to ONNX format\n",
    "try:\n",
    "    onnx_path = eval_model.export(format=\"onnx\", dynamic=True)\n",
    "    print(f\"Successfully exported ONNX model: {onnx_path}\")\n",
    "except Exception as e:\n",
    "    print(f\"ONNX export skipped: {e}\")\n",
    "\n",
    "# 2. Export to OpenVINO format (optimized for Intel Arc GPU / CPU)\n",
    "try:\n",
    "    openvino_path = eval_model.export(format=\"openvino\", half=True)\n",
    "    print(f\"Successfully exported OpenVINO model: {openvino_path}\")\n",
    "except Exception as e:\n",
    "    print(f\"OpenVINO export note: {e}\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"MH-WEED16 YOLO11 PIPELINE EXECUTION COMPLETE!\")\n",
    "print(f\"Training Artifacts:   runs/detect/{RUN_NAME}\")\n",
    "print(f\"Best Weights:         runs/detect/{RUN_NAME}/weights/best.pt\")\n",
    "print(f\"Evolved Config:       best_hyperparameters.yaml\")\n",
    "print(f\"Dataset Definition:   mhweed16.yaml\")\n",
    "print(\"=\" * 60)\n"
   ]
  }
 ],
