    "# Visual sample inspect function\n",
    "def render_sample_annotations(img_path, ann_path, ax=None):\n",
    "    img = cv2.imread(str(img_path))\n",
    "    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "    h_img, w_img, _ = img_rgb.shape\n",
    "    \n",
    "    # Generate distinct colors for 15 classes\n",
    "    np.random.seed(101)\n",
    "    colors = [tuple(int(c) for c in np.random.randint(0, 255, 3)) for _ in range(16)]\n",
    "    \n",
    "    with open(ann_path, 'r', encoding='utf-8') as f:\n",
    "        for line in f:\n",
    "            parts = line.strip().split()\n",
    "            if not parts:\n",
    "                continue\n",
    "            cls_id = int(parts[0])\n",
    "            xc, yc, bw, bh = map(float, parts[1:5])\n",
    "            \n",
    "            x1 = int((xc - bw / 2.0) * w_img)\n",
    "            y1 = int((yc - bh / 2.0) * h_img)\n",
    "            x2 = int((xc + bw / 2.0) * w_img)\n",
    "            y2 = int((yc + bh / 2.0) * h_img)\n",
    "            \n",
    "            color = colors[cls_id % len(colors)]\n",
    "            cv2.rectangle(img_rgb, (x1, y1), (x2, y2), color, 3)\n",
    "            \n",
    "            label_text = f\"C{cls_id}\"\n",
    "            cv2.putText(img_rgb, label_text, (x1, max(y1 - 8, 20)),\n",
    "                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2, cv2.LINE_AA)\n",
    "            \n",
    "    if ax is None:\n",
    "        fig, ax = plt.subplots(figsize=(8, 6))\n",
    "    ax.imshow(img_rgb)\n",
    "    ax.set_title(f\"{img_path.name}\", fontsize=11, fontweight='bold')\n",
    "    ax.axis('off')\n",
    "\n",
    "# Display 4 random sample images with weed annotations\n",
    "random.seed(42)\n",
    "sample_subset = random.sample(list(zip(image_files, ann_files)), 4)\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
    "for ax, (img_p, ann_p) in zip(axes.flatten(), sample_subset):\n",
    "    render_sample_annotations(img_p, ann_p, ax=ax)\n",
    "\n",
    "plt.suptitle(\"MH-Weed16: Sample Ground Truth Weed Annotations\", fontsize=15, fontweight='bold', y=1.01)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
