    "ax1.plot(df_tune['generation'], df_tune['fitness'].cummax(), color='#d32f2f', linestyle='--', linewidth=2, label='Best Cumulative')\n",
    "ax1.tick_params(axis='y', labelcolor=color)\n",
    "ax1.legend(loc='lower right')\n",
    "\n",
    "ax2 = ax1.twinx()\n",
    "color = '#2e7d32'\n",
    "ax2.set_ylabel('mAP@0.50', color=color, fontsize=11, fontweight='bold')\n",
    "ax2.plot(df_tune['generation'], df_tune['mAP50'], color=color, marker='s', alpha=0.5, linewidth=1.5, label='mAP50')\n",
    "ax2.tick_params(axis='y', labelcolor=color)\n",
    "\n",
    "plt.title(\"Hyperparameter Evolution: Generation Fitness Progression\", fontsize=13, fontweight='bold', pad=12)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Plot 2: Hyperparameter vs Fitness Scatter Plots\n",
    "key_params = ['lr0', 'momentum', 'weight_decay', 'box', 'cls', 'mosaic']\n",
    "fig, axes = plt.subplots(2, 3, figsize=(16, 9))\n",
    "\n",
    "for ax, param in zip(axes.flatten(), key_params):\n",
    "    x = df_tune[param]\n",
    "    y = df_tune['fitness']\n",
    "    \n",
    "    sns.regplot(x=x, y=y, ax=ax, order=2,\n",
    "                scatter_kws={'color': '#00838f', 'alpha': 0.7, 's': 60},\n",
    "                line_kws={'color': '#d84315', 'linewidth': 2})\n",
    "    \n",
    "    if param in ['lr0', 'weight_decay']:\n",
