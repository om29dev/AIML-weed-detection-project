   "source": [
    "## 3. 🔬 Agricultural Feature Engineering & Image Preparation\n",
    "Field imagery suffers from irregular outdoor lighting, harsh sunlight reflections, and complex soil-weed blending.\n",
    "Here we implement:\n",
    "1. **CLAHE (Contrast Limited Adaptive Histogram Equalization)** in LAB color space to normalize lighting while preserving natural plant textures.\n",
    "2. **Excess Green Index (ExG)**:\n",
    "   $$\\text{ExG} = 2G - R - B$$\n",
    "   Extracts high-contrast green biomass features to distinguish weeds from soil background.\n",
    "3. **Normalized Difference Green/Red Index (NGRDI)**:\n",
    "   $$\\text{NGRDI} = \\frac{G - R}{G + R + 10^{-6}}$$\n",
    "   Measures relative canopy chlorophyll density.\n",
    "4. **Spatial Foliage Density Features**: Computing per-image weed density and coverage percentage.\n",
    "5. **Top-Down Augmentation Pipeline**: Rotation invariance (`degrees=90`), vertical & horizontal flips (`flipud=0.5`, `fliplr=0.5`), and mosaic composition.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "0dc71f38",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1680x720 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def apply_clahe_lab(image_rgb, clip_limit=2.5, tile_grid_size=(8, 8)):\n",
    "    \"\"\"Apply CLAHE on Luminance (L) channel in LAB color space.\"\"\"\n",
    "    lab = cv2.cvtColor(image_rgb, cv2.COLOR_RGB2LAB)\n",
    "    l, a, b = cv2.split(lab)\n",
    "    \n",
    "    clahe = cv2.createCLAHE(clipLimit=clip_limit, tileGridSize=tile_grid_size)\n",
    "    l_enhanced = clahe.apply(l)\n",
    "    \n",
    "    lab_enhanced = cv2.merge((l_enhanced, a, b))\n",
    "    return cv2.cvtColor(lab_enhanced, cv2.COLOR_LAB2RGB)\n",
    "\n",
    "# Demonstrate CLAHE on a sample image\n",
    "sample_img = cv2.cvtColor(cv2.imread(str(image_files[0])), cv2.COLOR_BGR2RGB)\n",
    "clahe_img = apply_clahe_lab(sample_img)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "axes[0].imshow(sample_img)\n",
    "axes[0].set_title(\"Original Field Image (Direct Sunlight / Shadows)\", fontweight='bold')\n",
    "axes[0].axis('off')\n",
    "\n",
    "axes[1].imshow(clahe_img)\n",
    "axes[1].set_title(\"CLAHE Contrast-Enhanced Image (Normalized Foliage Edges)\", fontweight='bold')\n",
    "axes[1].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "e586b29a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2160x540 with 6 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def compute_vegetation_indices(image_rgb):\n",
    "    \"\"\"Extract Excess Green (ExG) and NGRDI vegetation indices.\"\"\"\n",
    "    img_float = image_rgb.astype(np.float32) / 255.0\n",
    "    r = img_float[:, :, 0]\n",
    "    g = img_float[:, :, 1]\n",
    "    b = img_float[:, :, 2]\n",
    "    \n",
    "    # 1. Excess Green Index (ExG = 2G - R - B)\n",
    "    exg = 2.0 * g - r - b\n",
    "    \n",
    "    # 2. Normalized Difference Green/Red Index\n",
    "    ngrdi = (g - r) / (g + r + 1e-6)\n",
    "    \n",
    "    # 3. Normalized Green Biomass Mask (Otsu threshold on ExG)\n",
    "    exg_norm = cv2.normalize(exg, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)\n",
    "    _, biomass_mask = cv2.threshold(exg_norm, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n",
    "    \n",
    "    return exg, ngrdi, biomass_mask\n",
    "\n",
    "exg_map, ngrdi_map, mask = compute_vegetation_indices(sample_img)\n",
    "\n",
    "fig, axes = plt.subplots(1, 4, figsize=(18, 4.5))\n",
    "axes[0].imshow(sample_img)\n",
    "axes[0].set_title(\"Original RGB\", fontweight='bold')\n",
    "axes[0].axis('off')\n",
    "\n",
    "im1 = axes[1].imshow(exg_map, cmap='YlGn')\n",
    "axes[1].set_title(\"Excess Green Index (ExG)\", fontweight='bold')\n",
    "axes[1].axis('off')\n",
    "plt.colorbar(im1, ax=axes[1], fraction=0.046, pad=0.04)\n",
    "\n",
    "im2 = axes[2].imshow(ngrdi_map, cmap='RdYlGn')\n",
    "axes[2].set_title(\"NGRDI Canopy Density\", fontweight='bold')\n",
    "axes[2].axis('off')\n",
    "plt.colorbar(im2, ax=axes[2], fraction=0.046, pad=0.04)\n",
    "\n",
    "axes[3].imshow(mask, cmap='gray')\n",
    "axes[3].set_title(\"Extracted Biomass Mask (Otsu)\", fontweight='bold')\n",
    "axes[3].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
