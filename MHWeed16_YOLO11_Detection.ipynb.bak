    "# Plot 1: Fitness Progression Curve\n",
    "fig, ax1 = plt.subplots(figsize=(10, 4.5))\n",
    "\n",
    "color = '#1565c0'\n",
    "ax1.set_xlabel('Evolution Generation', fontsize=11, fontweight='bold')\n",
