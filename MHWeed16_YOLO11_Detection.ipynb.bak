   ],
   "source": [
    "IMAGE_DIR = pathlib.Path(\"images\")\n",
    "ANN_DIR = pathlib.Path(\"annotations\")\n",
    "\n",
    "image_files = sorted(list(IMAGE_DIR.glob(\"*.jpeg\")) + list(IMAGE_DIR.glob(\"*.jpg\")) + list(IMAGE_DIR.glob(\"*.png\")))\n",
    "ann_files = sorted(list(ANN_DIR.glob(\"*.txt\")))\n",
    "\n",
    "print(f\"Total Images Found:      {len(image_files):,}\")\n",
    "print(f\"Total Annotations Found: {len(ann_files):,}\")\n",
    "\n",
    "# Parse all bounding boxes to evaluate class balance and geometry\n",
    "box_records = []\n",
    "class_counts = Counter()\n",
    "\n",
    "for ann_path in ann_files:\n",
    "    img_name = ann_path.stem\n",
    "    with open(ann_path, 'r', encoding='utf-8') as f:\n",
    "        for line in f:\n",
    "            parts = line.strip().split()\n",
    "            if not parts:\n",
    "                continue\n",
    "            cls_id = int(parts[0])\n",
    "            xc, yc, w, h = map(float, parts[1:5])\n",
    "            class_counts[cls_id] += 1\n",
    "            box_records.append({\n",
    "                'image': img_name,\n",
    "                'class_id': cls_id,\n",
    "                'x_center': xc,\n",
    "                'y_center': yc,\n",
    "                'width': w,\n",
    "                'height': h,\n",
    "                'aspect_ratio': w / (h + 1e-6),\n",
    "                'area_norm': w * h\n",
    "            })\n",
    "\n",
    "df_boxes = pd.DataFrame(box_records)\n",
    "print(f\"Total Bounding Boxes:    {len(df_boxes):,}\")\n",
    "print(f\"Distinct Classes:        {len(class_counts)} (IDs: {sorted(class_counts.keys())})\")\n",
    "\n",
    "# Plot Class Distribution\n",
    "plt.figure(figsize=(14, 5))\n",
    "sorted_classes = sorted(class_counts.items(), key=lambda x: x[0])\n",
    "class_labels = [f\"Class {c[0]}\" for c in sorted_classes]\n",
    "counts = [c[1] for c in sorted_classes]\n",
    "\n",
    "palette = sns.color_palette(\"viridis\", len(sorted_classes))\n",
    "bars = plt.bar(class_labels, counts, color=palette, edgecolor='black', alpha=0.85)\n",
    "\n",
    "for bar in bars:\n",
    "    yval = bar.get_height()\n",
    "    plt.text(bar.get_x() + bar.get_width()/2.0, yval + max(counts)*0.015, f\"{int(yval):,}\", \n",
    "             ha='center', va='bottom', fontsize=9, fontweight='bold')\n",
    "\n",
    "plt.title(\"MH-Weed16: Bounding Box Frequency per Weed Class\", fontsize=14, fontweight='bold', pad=15)\n",
    "plt.xlabel(\"Weed Class Identifier\", fontsize=12)\n",
    "plt.ylabel(\"Instance Count\", fontsize=12)\n",
    "plt.ylim(0, max(counts) * 1.15)\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
