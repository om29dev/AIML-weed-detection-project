    "# Small (<32px^2 = 0.0025 norm area), Medium (32^2 to 96^2 = 0.0025 to 0.0225), Large (>96^2 = >0.0225)\n",
    "def categorize_size(area):\n",
    "    if area < 0.0025:\n",
    "        return 'Small (<32²)'\n",
